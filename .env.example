# ---------------------------------------------------------------------------
# CYBERGRID — single environment file for local dev AND Vercel production
# ---------------------------------------------------------------------------
# Usage:
#   Local:     cp .env.example .env.local   (gitignored)
#   Vercel:    Add each variable in Vercel Dashboard → Settings → Environment Variables
# ---------------------------------------------------------------------------

# ===========================================================================
# APP — required everywhere
# ===========================================================================
# Local:    http://localhost:3000
# Vercel:   https://your-app.vercel.app (or custom domain)
APP_URL=http://localhost:3000

# Comma-separated additional origins allowed to POST to API (CSRF allowlist)
# Local:    http://localhost:3000
# Vercel:   https://your-app.vercel.app,https://your-custom-domain.com
ALLOWED_ORIGINS=http://localhost:3000

# Trust proxy headers (x-forwarded-for, cf-connecting-ip) — REQUIRED on Vercel
# Local:    0 (unless behind local proxy)
# Vercel:   1
TRUST_PROXY=0

# ===========================================================================
# DATABASE — required everywhere
# ===========================================================================
# Local:    mongodb://127.0.0.1:27018/cybergrid   (via `npm run db:dev`)
# Vercel:   mongodb+srv://user:pass@cluster.mongodb.net/cybergrid?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27018/cybergrid

# Test DB (only used by `npm test` — auto-started in CI)
TEST_MONGODB_URI=mongodb://127.0.0.1:27019/cybergrid_test

# ===========================================================================
# SECRETS — required everywhere (generate with: openssl rand -base64 48)
# ===========================================================================
# Signs session/CSRF material; rotating invalidates all sessions
SESSION_SECRET=dev-only-session-secret-change-me-0123456789abcdef

# Pepper mixed into password/token hashes; rotating invalidates all passwords
PASSWORD_PEPPER=dev-only-pepper-change-me-0123456789abcdef

# ===========================================================================
# PASSWORD HASHING (Argon2id) — tune for your hardware
# ===========================================================================
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# ===========================================================================
# SESSIONS
# ===========================================================================
SESSION_TTL_HOURS=168
SESSION_ABSOLUTE_TTL_DAYS=30
SESSION_COOKIE_NAME=cg_session
CSRF_COOKIE_NAME=cg_csrf

# ===========================================================================
# EMAIL — local uses outbox (viewable at /dev/outbox)
# ===========================================================================
# Local:    outbox (no SMTP needed)
# Vercel:   smtp (configure SMTP_URL) or use a provider like Resend/SendGrid
EMAIL_TRANSPORT=outbox
SMTP_URL=
EMAIL_FROM="CYBERGRID <no-reply@cybergrid.local>"

# ===========================================================================
# DEV ONLY — never enable in production
# ===========================================================================
# View captured emails at /dev/outbox (Vercel: keep false)
DEV_MAIL_PREVIEW=true

# Reduces Argon2 cost for test suite speed (Vercel CI: keep false)
AUTH_TEST_FAST_HASH=false