# ---------------------------------------------------------------------------
# CYBERGRID environment template.
# Copy to `.env.local` for development:  cp .env.example .env.local
# Never commit a filled-in copy. Every value below is read through
# `src/server/config/env.ts`, which refuses to boot on missing/weak secrets.
# ---------------------------------------------------------------------------

NODE_ENV=development

# Public origin of the app. Used for CSRF origin checks, absolute links in
# verification/reset emails, and secure-cookie decisions.
APP_URL=http://localhost:3000

# Comma separated list of additional origins allowed to POST to the API.
ALLOWED_ORIGINS=http://localhost:3000

# --- Database --------------------------------------------------------------
# Local dev:  npm run db:dev  (starts a local mongod on 27018 with a dbpath in ./.mongo)
MONGODB_URI=mongodb://127.0.0.1:27018/cybergrid
# Used by the test suite. `npm test` boots a throwaway mongod automatically.
TEST_MONGODB_URI=mongodb://127.0.0.1:27019/cybergrid_test

# --- Secrets ---------------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# SESSION_SECRET signs session/CSRF token material (the session id itself is random).
SESSION_SECRET=dev-only-session-secret-change-me-0123456789abcdef
# Pepper mixed into password/verification token hashing.
PASSWORD_PEPPER=dev-only-pepper-change-me-0123456789abcdef

# --- Password hashing (Argon2id) -------------------------------------------
# Defaults are tuned for an interactive server. Tune `memoryCost` upward as
# hardware allows; `argon2id` is pinned and must not be changed to argon2i.
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# --- Sessions --------------------------------------------------------------
SESSION_TTL_HOURS=168
SESSION_ABSOLUTE_TTL_DAYS=30
SESSION_COOKIE_NAME=cg_session
CSRF_COOKIE_NAME=cg_csrf

# --- Outbound email -------------------------------------------------------
# `outbox` writes messages to the emailOutbox collection (dev + tests).
# `smtp` requires SMTP_URL; see src/server/email for the transport interface.
EMAIL_TRANSPORT=outbox
SMTP_URL=
EMAIL_FROM="CYBERGRID <no-reply@cybergrid.local>"

# --- Dev conveniences -----------------------------------------------------
# Auto-seed the content catalog when the database is empty (dev only).
AUTO_SEED_CONTENT=true
# Expose /dev/outbox to read captured verification/reset emails. Never enable in prod.
DEV_MAIL_PREVIEW=true
# Reduce Argon2 cost for the test suite. Never enable outside CI.
AUTH_TEST_FAST_HASH=true
