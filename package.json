{
  "name": "cybergrid",
  "version": "0.1.0",
  "private": true,
  "description": "CYBERGRID - a 2D pixel-art cybersecurity academy. Networking is the first fully implemented campaign.",
  "engines": {
    "node": ">=20.11"
  },
  "allowScripts": {
    "esbuild": "0.28.2",
    "unrs-resolver": "1.12.2"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"tests/**/*.ts\" \"*.{ts,mjs,json,md}\" \"**/*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"tests/**/*.ts\" \"*.{ts,mjs,json,md}\" \"**/*.md\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:dev": "node scripts/dev-db.mjs",
    "db:status": "node scripts/dev-db.mjs status",
    "db:stop": "node scripts/dev-db.mjs stop",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run format:check",
    "test:security": "vitest run tests/security.test.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.1",
    "mongoose": "9.10.2",
    "next": "15.5.26",
    "phaser": "3.90.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "overrides": {
    "postcss": "8.5.28"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.26",
    "eslint-config-prettier": "10.1.8",
    "mongodb-memory-server-core": "11.3.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "^5.0.2"
  }
}
